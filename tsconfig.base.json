{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@brainsonify/sonification": [
        "libs/sonification/src/index.ts"
      ],
      "@brainsonify/control": [
        "libs/control/src/index.ts"
      ],
      "niivue-mcp": [
        "libs/niivue-mcp/src/index.ts"
      ],
      "niivue-mcp/server": [
        "libs/niivue-mcp/src/server/index.ts"
      ],
      "niivue-mcp/browser": [
        "libs/niivue-mcp/src/browser/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
